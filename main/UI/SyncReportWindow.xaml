<Window x:Class="GuvenlikDuvarim.UI.SyncReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Senkronizasyon Raporu" Height="460" Width="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="🔄 Senkronizasyon Tamamlandı" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtTimeTaken" Text="0.0 sn" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Kompakt Sayaç Kartları -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,10">
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,4,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TARANAN KLASÖR" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock x:Name="txtScannedFolders" Text="0" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource ForegroundBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="2,0,2,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="YENİ EKLENEN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock x:Name="txtAddedExes" Text="0" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="4,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TEMİZLENEN HAYALET" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock x:Name="txtRemovedExes" Text="0" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Liste Kartı -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="➕ Yeni Eklenen Dosyalar" FontSize="11.5">
                    <ListBox x:Name="lstAddedExes" Background="Transparent" BorderThickness="0" Margin="4" FontFamily="Consolas, Segoe UI" FontSize="11" Foreground="{DynamicResource ForegroundBrush}"/>
                </TabItem>
                <TabItem Header="➖ Temizlenen Hayalet Kurallar" FontSize="11.5">
                    <ListBox x:Name="lstRemovedExes" Background="Transparent" BorderThickness="0" Margin="4" FontFamily="Consolas, Segoe UI" FontSize="11" Foreground="{DynamicResource ForegroundBrush}"/>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Alt Kapat -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="Kapat" HorizontalAlignment="Right" Width="80" Padding="8,4" Style="{DynamicResource PrimaryButton}" Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
