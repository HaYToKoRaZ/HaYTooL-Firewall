<Window x:Class="GuvenlikDuvarim.UI.StartupGuardAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛡️ HaYTooL Başlangıç &amp; Servis Koruma Kalkanı"
        Height="460" Width="650" MinWidth="610" MinHeight="430"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Uyarı Başlığı ve İkon -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Detay Kartı -->
            <RowDefinition Height="*"/>
            <!-- 2: Tavsiye / Bilgilendirme -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Alt Eylem Butonları -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->
        <Border Grid.Row="0" Background="#22EF4444" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛡️" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtEventTitle" Text="Yeni Başlangıç / Servis Eklemesi Algılandı!" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Text="Bu yazılımın Windows açılışında otomatik başlamasına izin vermek istiyor musunuz?" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- DETAY KARTI -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tür -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Kategori Türü:" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" Margin="0,0,0,10"/>
                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SecondaryBrush}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock x:Name="txtType" Text="Başlangıç Uygulaması" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" FontSize="11.5"/>
                    </Border>

                    <!-- Öğe Adı -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Uygulama / Öğe:" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtName" Grid.Row="1" Grid.Column="1" Text="ProgramName" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Dosya / Komut -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Dosya / Komut:" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12" Margin="0,0,0,10"/>
                    <TextBox x:Name="txtCommand" Grid.Row="2" Grid.Column="1" Text="C:\Program Files\..." IsReadOnly="True" TextWrapping="Wrap" FontSize="11" Padding="6,5" Background="{DynamicResource InnerSectionBrush}" Foreground="{DynamicResource ForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10"/>

                    <!-- Konum -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Kayıt Konumu:" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12"/>
                    <TextBlock x:Name="txtLocation" Grid.Row="3" Grid.Column="1" Text="HKCU\Run" Foreground="{DynamicResource ForegroundBrush}" FontSize="11" TextWrapping="Wrap"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- BİLGİLENDİRME -->
        <TextBlock Grid.Row="2" Text="💡 'Hayır, Kaldır' yalnızca başlangıç kaydını siler. Şüpheli yazılımlar için 'Sil + Duvarla Engelle' seçeneğini kullanabilirsiniz." FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" FontStyle="Italic" Margin="0,10,0,12"/>

        <!-- ALT BUTONLAR -->
        <DockPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="⚪ Devre Dışı Bırak" Style="{DynamicResource SecondaryButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnDisable_Click" ToolTip="Kaydı silmez, başlangıç listesinde Devre Dışı olarak tutar"/>
                <Button Content="🛡️ Sil + Duvarla Engelle" Style="{DynamicResource DangerButton}" Padding="10,6" Click="BtnBlockAndDelete_Click" ToolTip="Başlangıçtan kaldırır ve .exe dosyasının ağ erişimini engeller"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🗑️ Hayır, Kaldır" Style="{DynamicResource SecondaryButton}" Foreground="{DynamicResource DangerBrush}" Padding="12,6" Margin="0,0,8,0" Click="BtnRemoveOnly_Click" ToolTip="Uygulamanın başlangıca eklenmesini reddeder ve kaydı kaldırır"/>
                <Button Content="🟢 Evet, İzin Ver" Style="{DynamicResource SuccessButton}" Padding="14,6" Click="BtnAllow_Click" ToolTip="Başlangıç kaydına güvenli olarak izin verir"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
