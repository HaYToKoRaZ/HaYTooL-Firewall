<Window x:Class="GuvenlikDuvarim.UI.ServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛠️ Windows Hizmetleri Yöneticisi"
        Height="640" Width="1080" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Başlık -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Arama ve Filtreler -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Hizmetler Tablosu -->
            <RowDefinition Height="*"/>
            <!-- 3: Alt Eylem Butonları -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛠️ Windows Hizmetleri (Services Manager)" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource SecondaryBrush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtServiceCount" Text="0 Hizmet Bulundu" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnRefresh" Content="🔄 Yenile" Style="{DynamicResource SecondaryButton}" Padding="10,4" Click="BtnRefresh_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- ARAMA VE FİLTRELER -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Center">
            <!-- Arama Kutusu -->
            <Grid Width="260" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBox x:Name="txtSearch" Padding="8,6" TextChanged="TxtSearch_TextChanged" FontSize="12"/>
                <TextBlock x:Name="txtSearchPlaceholder" Text="🔍 Hizmet adı, görünen ad veya dosya ara..." IsHitTestVisible="False"
                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Filtre Checkboxları -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="chkRunningOnly" Content="🟢 Çalışanlar" Margin="0,0,14,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="chkStoppedOnly" Content="🔴 Durdurulanlar" Margin="0,0,14,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="chkAutoOnly" Content="⚡ Otomatik" Margin="0,0,14,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="chkDisabledOnly" Content="⚪ Devre Dışı" Margin="0,0,14,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="chkHideMicrosoft" Content="🪟 Windows / Microsoft Hizmetlerini Gizle" Margin="0,0,14,0" Foreground="{DynamicResource PrimaryBrush}" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            </StackPanel>
        </WrapPanel>

        <!-- HİZMETLER TABLOSU -->
        <DataGrid x:Name="dgServices" Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                  Background="{DynamicResource TreeViewBackgroundBrush}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource AlternatingRowBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  HeadersVisibility="Column">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FontSize" Value="11.5"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="🟢 Hizmeti Başlat" Click="MenuStart_Click"/>
                    <MenuItem Header="🔴 Hizmeti Durdur" Click="MenuStop_Click"/>
                    <MenuItem Header="🔄 Yeniden Başlat" Click="MenuRestart_Click"/>
                    <Separator/>
                    <MenuItem Header="⚙️ Başlangıç Türünü Değiştir">
                        <MenuItem Header="⚡ Otomatik (Auto)" Click="MenuSetAuto_Click"/>
                        <MenuItem Header="✋ Manuel (Demand)" Click="MenuSetManual_Click"/>
                        <MenuItem Header="⚪ Devre Dışı (Disabled)" Click="MenuSetDisabled_Click"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="🛡️ Güvenlik Duvarında Engelle" Click="MenuBlockInFirewall_Click"/>
                    <MenuItem Header="🟢 Güvenlik Duvarında İzin Ver" Click="MenuAllowInFirewall_Click"/>
                    <MenuItem Header="📁 Dosya Konumunu Aç (Gezgin)" Click="MenuOpenLocation_Click"/>
                    <Separator/>
                    <MenuItem Header="🗑️ Hizmeti Sil (Kalıcı)" Foreground="{DynamicResource DangerBrush}" Click="MenuDelete_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <!-- Durum -->
                <DataGridTemplateColumn Header="Durum" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Görünen Ad -->
                <DataGridTextColumn Header="Görünen Ad (Display Name)" Binding="{Binding DisplayName}" Width="250"/>

                <!-- Hizmet Adı -->
                <DataGridTextColumn Header="Hizmet Adı (Service Name)" Binding="{Binding ServiceName}" Width="160"/>

                <!-- Başlangıç Türü -->
                <DataGridTemplateColumn Header="Başlangıç Türü" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StartupType}" Foreground="{Binding StartupTypeColor}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Dosya Yolu -->
                <DataGridTextColumn Header="Yürütülebilir Dosya (Executable)" Binding="{Binding CleanExePath}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ALT EYLEM BUTONLARI -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="🟢 Başlat" Style="{DynamicResource SuccessButton}" Padding="12,5" Margin="0,0,6,0" Click="MenuStart_Click"/>
                <Button Content="🔴 Durdur" Style="{DynamicResource DangerButton}" Padding="12,5" Margin="0,0,6,0" Click="MenuStop_Click"/>
                <Button Content="🔄 Yeniden Başlat" Style="{DynamicResource SecondaryButton}" Padding="12,5" Margin="0,0,10,0" Click="MenuRestart_Click"/>

                <ComboBox x:Name="cmbStartupTypeAction" Width="140" Height="28" Margin="0,0,6,0" VerticalAlignment="Center" SelectedIndex="0">
                    <ComboBoxItem Tag="auto">⚡ Otomatik Yap</ComboBoxItem>
                    <ComboBoxItem Tag="demand">✋ Manuel Yap</ComboBoxItem>
                    <ComboBoxItem Tag="disabled">⚪ Devre Dışı Bırak</ComboBoxItem>
                </ComboBox>
                <Button Content="Uygula" Style="{DynamicResource SecondaryButton}" Padding="10,4" Margin="0,0,10,0" Click="BtnApplyStartupType_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🛡️ Güvenlik Duvarında Engelle" Style="{DynamicResource DangerButton}" Padding="12,5" Margin="0,0,6,0" Click="MenuBlockInFirewall_Click"/>
                <Button Content="🗑️ Hizmeti Sil" Style="{DynamicResource SecondaryButton}" Foreground="{DynamicResource DangerBrush}" Padding="10,5" Click="MenuDelete_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
