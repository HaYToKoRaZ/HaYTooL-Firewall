<Window x:Class="GuvenlikDuvarim.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="HaYTooL Firewall" 
        Icon="/Resources/firewall.ico"
        Height="720" Width="1240" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
            <DockPanel x:Name="HeaderPanel">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="/Resources/firewall.png" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtHeaderTitle" Text="HaYTooL Firewall" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                    <Border x:Name="bdVersion" Background="{DynamicResource SecondaryBrush}" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="BdVersion_MouseLeftButtonDown" ToolTip="GitHub Depo Sayfasını Aç">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtVersionBadge" Text="v2.1.0" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Ellipse x:Name="ellipseUpdateDot" Width="7" Height="7" Fill="#EF4444" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="bdAdminStatus" CornerRadius="6" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtAdminStatus" Text="ğŸŸ¢ YÃ¶netici Modu" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <ComboBox x:Name="cmbLanguage" Width="155" Margin="0,0,10,0" VerticalAlignment="Center" SelectionChanged="CmbLanguage_SelectionChanged" SelectedValuePath="Code">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding FlagIconPath}" Width="20" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="btnToggleFullSafe" Content="🛡️ FullSafe: KAPALI" Style="{DynamicResource DangerButton}" Margin="0,0,4,0" Click="BtnToggleFullSafe_Click"/>
                    <Button x:Name="btnFullSafeHelp" Content="❓" Style="{DynamicResource SecondaryButton}" Foreground="#FFFFFF" Width="32" Padding="0" Margin="0,0,10,0" Click="BtnFullSafeHelp_Click" ToolTip="FullSafe Modu Nedir &amp; Nasıl İzin Verilir?"/>
                    <Button x:Name="btnLocalBackup" Content="💾 Yedekler" Style="{DynamicResource SecondaryButton}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,0" Click="BtnLocalBackup_Click" ToolTip="Yerel Yedek Yönetimi"/>
                    <Button x:Name="btnGistBackup" Content="☁️ Gist" Style="{DynamicResource SecondaryButton}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0" Click="BtnGistBackup_Click" ToolTip="GitHub Gist Bulut Yedekleme"/>
                    <Button x:Name="btnRefreshHeader" Content="🔄 Listeyi Yenile" Style="{DynamicResource SecondaryButton}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0" Click="BtnRefreshHeader_Click"/>
                    <!-- Tema SeÃ§ici ComboBox -->
                    <ComboBox x:Name="cmbThemeSelector" Width="160" ToolTip="Tema Seç" SelectionChanged="CmbThemeSelector_SelectionChanged">
                        <ComboBoxItem Tag="Dark"    IsSelected="True">ğŸŒ™ Koyu Tema</ComboBoxItem>
                        <ComboBoxItem Tag="Light">â˜€ï¸  AÃ§Ä±k Tema</ComboBoxItem>
                        <ComboBoxItem Tag="Discord">ğŸ”µ Discord TemasÄ±</ComboBoxItem>
                        <ComboBoxItem Tag="YouTube">â–¶ï¸  YouTube TemasÄ±</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- DASHBOARD BODY (2 COLUMNS) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- SÃ¼tun 1: Profiller -->
                <ColumnDefinition Width="260"/>
                <!-- AyÄ±rÄ±cÄ± -->
                <ColumnDefinition Width="14"/>
                <!-- SÃ¼tun 2: Ä°Ã§erik & Aktif Kurallar (BirleÅŸik) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL 1: PROFÄ°LLER (GRUPLAR) -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtProfilesTitle" Grid.Row="0" Text="1. Profiller" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,12"/>

                    <!-- Yeni Profil GiriÅŸ AlanÄ± -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox x:Name="txtNewCategory" Padding="8,5"/>
                            <TextBlock x:Name="txtNewCategoryPlaceholder" Text="Yeni Profil AdÄ±..." IsHitTestVisible="False"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtNewCategory}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button x:Name="btnAddCategory" Grid.Column="1" Content="Ekle" Click="BtnAddCategory_Click" Padding="12,6"/>
                    </Grid>

                    <!-- Profil Listesi -->
                    <ListBox x:Name="lstCategories" Grid.Row="2" SelectionChanged="LstCategories_SelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="miCategoryToggle" Header="ğŸ¯ SeÃ§ili Profili AÃ§ / Kapat (Aktif/Pasif)" Click="CtxCategoryToggle_Click"/>
                                <MenuItem x:Name="miCategoryRename" Header="âœï¸ SeÃ§ili Profili Yeniden AdlandÄ±r" Click="CtxCategoryRename_Click"/>
                                <Separator/>
                                <MenuItem x:Name="miCategoryDelete" Header="ğŸ—‘ï¸ SeÃ§ili Profili Sil" Click="CtxCategoryDelete_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,2">
                                    <TextBlock Text="{Binding StatusDot}" Foreground="{Binding StatusColor}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Profil Sil Butonu -->
                    <Button x:Name="btnDeleteCategory" Grid.Row="3" Content="SeÃ§ili Profili Sil" Style="{StaticResource DangerButton}" Margin="0,10,0,0" Click="BtnDeleteCategory_Click"/>
                </Grid>
            </Border>

            <!-- PANEL 2: Ä°Ã‡ERÄ°K (AÄAÃ‡ GÃ–RÃœNÃœM) + ENGELLEME SEÃ‡ENEKLERÄ° -->
            <Border x:Name="bdPanel2" Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="10" Padding="14"
                    AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>             <!-- 0: BaÅŸlÄ±k + Senkronize -->
                        <RowDefinition Height="Auto"/>             <!-- 1: Eylem butonlarÄ± -->
                        <RowDefinition Height="*" MinHeight="80"/> <!-- 2: TreeView â€” KlasÃ¶r/EXE hiyerarÅŸisi -->
                        <RowDefinition Height="Auto"/>             <!-- 3: Engelleme seÃ§enekleri -->
                        <RowDefinition Height="Auto"/>             <!-- 4: Kural uygulama butonu -->
                    </Grid.RowDefinitions>

                    <!-- BaÅŸlÄ±k + Senkronize Et -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="txtProfileContentTitle" Text="2. Ä°Ã§erik" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="btnSyncFolders" Content="🔄 Senkronize Et" Style="{DynamicResource SecondaryButton}" Foreground="{DynamicResource DangerBrush}"
                                HorizontalAlignment="Right" Padding="8,4" Click="BtnSyncFolders_Click"/>
                    </DockPanel>

                    <!-- Eylem Butonları -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,8">
                        <Button x:Name="btnAddExe" Content="+ EXE" Foreground="{DynamicResource DangerBrush}" Margin="0,0,4,0" Click="BtnAddExe_Click" Style="{DynamicResource SecondaryButton}"/>
                        <Button x:Name="btnAddFolder" Content="+ Klasör" Foreground="{DynamicResource DangerBrush}" Margin="2,0,2,0" Click="BtnAddFolder_Click" Style="{DynamicResource SecondaryButton}"/>
                        <Button x:Name="btnRemoveItem" Content="− Çıkar" Foreground="#FFFFFF" Margin="4,0,0,0" Click="BtnRemoveItem_Click" Style="{DynamicResource DangerButton}"/>
                    </UniformGrid>

                    <!-- HiyerarÅŸik Ä°Ã§erik TreeView: KlasÃ¶rler (geniÅŸletilebilir) + EXE'ler -->
                    <TreeView x:Name="tvContent" Grid.Row="2"
                              Background="{DynamicResource TreeViewBackgroundBrush}"
                              BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1"
                              AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="3,3"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="miItemOpenLocation" Header="ğŸ“‚ Konumu AÃ§ (Gezgin)" Click="CtxOpenLocation_Click"/>
                                <Separator/>
                                <MenuItem x:Name="miItemRemove" Header="ğŸ—‘ï¸ Listeden Ã‡Ä±kar" Click="BtnRemoveItem_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="1,2">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0"
                                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="500"
                                               ToolTip="{Binding ToolTipText}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Engelleme / Ä°zin SeÃ§enekleri -->
                    <Border Grid.Row="3" Background="{DynamicResource InnerSectionBrush}" CornerRadius="8" Padding="10" Margin="0,8,0,8">
                        <StackPanel>
                            <TextBlock Text="Engelleme / Ä°zin SeÃ§enekleri" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,5"/>
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="chkBlockInbound" Content="Gelen (Inbound)" IsChecked="True" Margin="0,0,4,2"/>
                                <CheckBox x:Name="chkBlockOutbound" Content="Giden (Outbound)" IsChecked="True" Margin="4,0,0,2"/>
                            </UniformGrid>
                            <Separator Margin="0,5"/>
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="rbBlock" Content="â›” Engelle (Block)" IsChecked="True" GroupName="grpRuleAction" Margin="0,0,4,0"/>
                                <RadioButton x:Name="rbAllow" Content="ğŸŸ¢ Ä°zin Ver (Allow)" GroupName="grpRuleAction" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Profil Kural Uygulama Butonu -->
                    <Button x:Name="btnApplyRules" Grid.Row="4" Content="âš¡ Profil KurallarÄ±nÄ± Uygula"
                            Height="40" Style="{StaticResource SuccessButton}" Click="BtnApplyRules_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- LIVE SCAN PROGRESS OVERLAY -->
        <Grid x:Name="gridProgressOverlay" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" 
                    Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="24"
                    BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock x:Name="txtProgressTitle" Text="ğŸ” KlasÃ¶r TaranÄ±yor..." FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock x:Name="txtProgressCount" Text="0 .exe bulundu" HorizontalAlignment="Right" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="12"/>
                    </DockPanel>

                    <ProgressBar x:Name="pbScanProgress" IsIndeterminate="True" Height="10" Margin="0,0,0,12" 
                                 Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource SecondaryBrush}"/>

                    <TextBlock x:Name="txtProgressCurrentPath" Text="TaranÄ±yor..." TextTrimming="CharacterEllipsis" 
                               FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" FontFamily="Consolas, Segoe UI"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
